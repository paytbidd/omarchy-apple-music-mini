 }
 
+// MusicKit artwork.url is a template (`{w}x{h}bb.jpg`) or a small CDN size.
+// The shell upgrades the size; here we only pick the best source string.
+function artworkUrlFromItem(item) {
+  var artwork = item && item.attributes && item.attributes.artwork
+  var url = artwork && artwork.url ? String(artwork.url) : ""
+  return url
+}
+
+function artworkUrlFromMediaSession(metadata) {
+  var list = metadata && metadata.artwork
+  if (!list || !list.length) return ""
+  var best = ""
+  var bestArea = -1
+  for (var i = 0; i < list.length; i++) {
+    var src = list[i] && list[i].src ? String(list[i].src) : ""
+    if (!src) continue
+    var sizes = String(list[i].sizes || "")
+    var match = sizes.match(/(\d+)\s*[x×]\s*(\d+)/i)
+    var area = match ? Number(match[1]) * Number(match[2]) : 0
+    if (area > bestArea) {
+      bestArea = area
+      best = src
+    }
+  }
+  return best
+}
+
 function normalizeQueueEntry(item, index) {
   var attributes = item && item.attributes
   if (!attributes || !attributes.name) return null
@@ -460,6 +487,7 @@ function collectBridgeState() {
