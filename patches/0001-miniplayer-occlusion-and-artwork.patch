 }
 
-// Chromium normally publishes either an HTTPS cover or a canonical local
-// file URI. Reject every other Image source scheme, remote file authorities,
-// whitespace/control characters, and overlong URLs.
+// Chromium's MPRIS art dump is often 150px. Apple CDN URLs carry a size in
+// the path (`{w}x{h}bb.jpg` or `/60x60bb.jpg`); request a square large
+// enough for the miniplayer at HiDPI.
+var ARTWORK_EDGE = 1200
+
+function upgradeArtworkUrl(url) {
+  var value = String(url || "")
+  if (!value) return ""
+  if (value.indexOf("{w}") !== -1 || value.indexOf("{h}") !== -1) {
+    return value.split("{w}").join(String(ARTWORK_EDGE)).split("{h}").join(String(ARTWORK_EDGE))
+  }
+  return value.replace(/\/(\d+)x(\d+)([a-z]*)(\.[a-z0-9]+)(?:\?.*)?$/i,
+    function(match, width, height, suffix, ext) {
+      var edge = Math.max(Number(width), Number(height))
+      if (!(edge > 0) || edge >= ARTWORK_EDGE) return match
+      return "/" + ARTWORK_EDGE + "x" + ARTWORK_EDGE + suffix + ext
+    })
+}
+
+// Chromium normally publishes either an HTTPS cover or a /tmp dump of one.
+// Reject every other Image source, including Chromium's product logo — MPRIS
+// falls back to that application icon when Media Session metadata is cleared
+// on pause, which is not cover art.
 function artworkUrl(value) {
   var url = String(value || "")
   if (!url || url.length > 2048 || /[\u0000-\u0020\u007f]/.test(url)) return ""
-  if (/^https:\/\/[^/?#]+(?:[/?#]|$)/i.test(url)) return url
-  if (/^file:\/\/\/(?!\/)/i.test(url)) return url
+  if (/product_logo/i.test(url)) return ""
+  if (/\/usr\/(lib|share)\//i.test(url) && /chrom/i.test(url)) return ""
+  if (/^https:\/\/[^/?#]+(?:[/?#]|$)/i.test(url)) {
+    if (/(^|\.)gstatic\.com\/chrome/i.test(url)) return ""
+    return upgradeArtworkUrl(url)
+  }
+  if (/^file:\/\/\/tmp\//i.test(url)) return url
   return ""
 }
 
